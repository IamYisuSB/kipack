---
// A CSS-drawn phone showing Kipack's packing list screen. Drawn rather
// than a screenshot so it stays crisp at any size and in sync with the
// site's palette.
const items = [
  { name: 'Pasaporte', done: true },
  { name: 'Gafas de sol', done: true },
  { name: 'Chubasquero ligero', done: false },
  { name: 'Zapatillas cómodas', done: false },
  { name: 'Adaptador de enchufe', done: true },
];
---

<div class="phone" aria-hidden="true">
  <div class="notch"></div>
  <div class="screen">
    <div class="app-bar">
      <span class="back">‹</span>
      <span class="title">Roma</span>
      <span class="spark">✦</span>
    </div>
    <p class="meta">20 oct — 24 oct · Ciudad · 2 personas</p>

    <div class="progress"><span style="width: 62%"></span></div>
    <p class="meta small">18 de 29 artículos en la maleta</p>

    <div class="weather">
      <div class="season">🍂 Otoño</div>
      <div class="temps">
        <span>🌡️ 12°–21°</span>
        <span>💧 30%</span>
      </div>
    </div>

    <div class="chips">
      <span class="chip on">Todas</span>
      <span class="chip">🧳 Cabina</span>
      <span class="chip">🧳 Facturada</span>
    </div>

    <div class="card">
      <div class="card-head">
        <span class="cat">👕</span>
        <strong>Esenciales</strong>
        <span class="count">3/5</span>
      </div>
      {items.map((item) => (
        <div class:list={['row', { done: item.done }]}>
          <span class="check">{item.done ? '✓' : ''}</span>
          <span class="name">{item.name}</span>
        </div>
      ))}
    </div>

    <div class="card second">
      <div class="card-head">
        <span class="cat">🪪</span>
        <strong>Documentos</strong>
        <span class="count">1/3</span>
      </div>
      <div class="row done"><span class="check">✓</span><span class="name">DNI</span></div>
      <div class="row"><span class="check"></span><span class="name">Reserva del hotel</span></div>
    </div>
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 300px;
    aspect-ratio: 9 / 19;
    border-radius: 46px;
    padding: 12px;
    background: linear-gradient(145deg, #2a3d31, #0e1912);
    box-shadow:
      0 0 0 2px rgba(198, 232, 62, 0.12),
      0 40px 80px -20px rgba(0, 0, 0, 0.7),
      0 0 120px -30px rgba(198, 232, 62, 0.35);
  }

  .notch {
    position: absolute;
    top: 22px;
    left: 50%;
    transform: translateX(-50%);
    width: 84px;
    height: 22px;
    border-radius: 20px;
    background: #050a07;
    z-index: 2;
  }

  .screen {
    height: 100%;
    border-radius: 36px;
    background: #ecf2e8;
    color: #16241c;
    padding: 52px 16px 16px;
    overflow: hidden;
    font-size: 12px;
  }

  .app-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 800;
  }

  .app-bar .title { font-size: 20px; flex: 1; margin-left: 10px; }
  .back { font-size: 22px; line-height: 1; }
  .spark { color: #3e7a54; }

  .meta { color: #6b7a70; margin: 4px 0 10px; }
  .meta.small { font-size: 10.5px; margin-top: 6px; }

  .progress {
    height: 8px;
    border-radius: 99px;
    background: #dfe6da;
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: #c6e83e;
  }

  .weather {
    background: #fff;
    border-radius: 16px;
    padding: 10px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }

  .season {
    background: #fde5cf;
    color: #9a4d12;
    font-weight: 700;
    border-radius: 99px;
    padding: 3px 10px;
  }

  .temps { display: flex; gap: 8px; color: #16241c; font-weight: 600; white-space: nowrap; }
  .season { white-space: nowrap; }

  .chips { display: flex; gap: 6px; margin-bottom: 10px; white-space: nowrap; }

  .chip {
    border-radius: 99px;
    padding: 4px 10px;
    background: #fff;
    font-weight: 600;
    font-size: 10.5px;
  }

  .chip.on { background: #eaf7c0; }

  .card { background: #fff; border-radius: 18px; padding: 12px; }
  .card.second { margin-top: 10px; }

  .card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 8px;
    margin-bottom: 4px;
    border-bottom: 1px solid #eef1ec;
  }

  .cat {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: #eaf7c0;
    display: grid;
    place-items: center;
  }

  .card-head strong { flex: 1; font-size: 13px; }
  .count { color: #6b7a70; }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 0;
  }

  .check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid #a9bfae;
    display: grid;
    place-items: center;
    font-size: 11px;
    color: #fff;
    font-weight: 800;
  }

  .row.done .check { background: #3e7a54; border-color: #3e7a54; }
  .row.done .name { color: #9aa79e; text-decoration: line-through; }

  @media (max-width: 400px) {
    .phone { width: 270px; }
    .screen { font-size: 11px; padding: 48px 12px 12px; }
    .weather { padding: 8px 10px; }
    .temps { gap: 6px; }
  }
</style>
