<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own Splash Screen API overlay (icon inside a
         fixed rounded/circular mask) instead of using launch_background.xml
         directly. Matching every color here to splash_background makes that
         mask invisible so it reads as one solid, full-bleed background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
