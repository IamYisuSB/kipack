{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kipack-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Non-secret settings. OPENROUTER_API_KEY and APP_TOKEN are secrets,
  // set with `npx wrangler secret put <NAME>` — never written here.
  "vars": {
    "MODEL": "deepseek/deepseek-v4-flash-0731"
  },

  // Per-IP limit on AI calls, so nobody can burn through the OpenRouter
  // credit with a script. Period must be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
